# Copy to .env.local for `next dev`, or set these in the deployment platform's
# environment settings for `next start`. Nothing in this repo reads .env.example
# itself — it exists only as documentation of what V15 needs.
#
# Every one of these is currently UNSET in the session that wrote V15 — none of the
# integrations below (Supabase, Shopify, Resend) were exercised against a live
# service. See db/README.md and lib/server/shopify.ts for what was and wasn't
# verified without them, and what to check once real credentials exist.

# ---------------------------------------------------------------------------
# Persistence (Task 2) — see db/README.md
# ---------------------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard. Use the SERVICE ROLE key, not
# anon — the `audits` table has RLS enabled with no policies, so anon can do nothing
# against it by design (see db/migrations/0001_audits.sql).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only for local development/testing without a Supabase project: set to "file" to
# force the file-backed AuditStore test double (lib/server/audit-store.file.ts).
# Refused outright in production (NODE_ENV=production) even if set — see
# lib/server/audit-store.ts. Leave unset in any real deployment.
# AUDIT_STORE=file
# AUDIT_STORE_FILE_PATH=/tmp/kitchiri-rental-audits.json

# Protects POST /api/taikyo/cleanup (the 90-day-expiry sweep) — required if using the
# HTTP-based cleanup path instead of (or alongside) pg_cron. Any long random string.
CLEANUP_SECRET=

# ---------------------------------------------------------------------------
# Shopify Checkout + webhooks (Task 3) — see lib/server/shopify.ts
# ---------------------------------------------------------------------------
# The store's domain, e.g. "beyond-culture.myshopify.com" or a connected custom
# domain. Used to build the checkout permalink (GET /api/taikyo/checkout).
SHOPIFY_STORE_DOMAIN=

# The Shopify VARIANT id (not product id) for the ¥3,980 「退去費用チェック」 product.
# Find it in the Shopify admin: Products -> the product -> the variant's URL contains
# its numeric id.
SHOPIFY_VARIANT_ID=

# The signing secret for the orders/paid and refunds/create webhook subscriptions
# (Settings -> Notifications -> Webhooks in the Shopify admin, or created via the
# Admin API). Both webhook handlers verify every delivery's HMAC against this before
# doing anything else.
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Report-link email (Task 3) — see lib/server/mail.ts
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard.
RESEND_FROM_EMAIL=

# Absolute origin used to build the report link inside the email
# (e.g. "https://taikyo.example.jp"). Without it, sendReportEmail() logs the report
# path instead of sending — see the file-level comment there.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# PDF export (Task 4) — see app/api/taikyo/pdf/[kind]/[id]/route.ts
# ---------------------------------------------------------------------------
# Only needed if the deployment target does not have Playwright's own downloaded
# Chromium available. Left unset, Playwright resolves its own bundled browser.
# PLAYWRIGHT_CHROMIUM_PATH=
