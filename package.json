{
  "name": "rental-lifecycle-audit-suite",
  "version": "0.0.0",
  "private": true,
  "description": "Unified rental lifecycle audit suite: move-in cost audits (初期費用) and move-out restoration audits (原状回復).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:corpus": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/golden-set/validate-corpus.ts",
    "audit:citations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/citation-audit.ts",
    "eval:corpus": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/golden-set/evaluate-corpus.ts",
    "eval:holdout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/holdout/classify-holdout.ts",
    "eval:factloop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/golden-set/factloop-corpus.ts",
    "validate:phrases": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-phrases.ts",
    "audit:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/citation-verify.ts --list",
    "audit:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/citation-verify.ts",
    "legal:manifest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-legal-manifest.ts",
    "eval:segment": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/segment-check.ts",
    "eval:batch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/batch-check.ts",
    "eval:letter": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/letter-check.ts",
    "eval:ingest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/ingest-check.ts",
    "validate:copy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/copy-check.ts",
    "eval:audit-store": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/audit-store-check.ts",
    "eval:webhook": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/webhook-check.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
